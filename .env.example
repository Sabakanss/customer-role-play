# LLMプロバイダ切り替え: "bedrock" または "openai"
LLM_PROVIDER=bedrock

# Amazon Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# OpenAI（LLM_PROVIDER=openai の場合のみ使用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# データベース
DATABASE_URL=sqlite:///./app/db/app.db

# アプリの公開URL（末尾スラッシュなし）。CognitoのコールバックURL登録と一致させる
APP_BASE_URL=http://127.0.0.1:8000

# Cookie署名用の秘密鍵。本番用は `python -c "import secrets; print(secrets.token_urlsafe(32))"` 等で生成する
SESSION_SECRET_KEY=dev-insecure-secret-change-me
# ローカル(http)開発時のみFalseにする。本番(https)では必ずTrue
SECURE_COOKIES=false

# Amazon Cognito（ユーザー認証）
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
